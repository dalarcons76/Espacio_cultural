---
import Layout from "../layouts/layout.astro";
---

<Layout titulo="Nosotros | Espacio Cultural">
    <section class="nosotros">
        <h2>Sobre nosotros</h2>

        <p>
            Espacio Cultural es una organización dedicada a promover el arte, la
            creatividad y el aprendizaje. Nuestro propósito es ofrecer un lugar
            donde las personas puedan desarrollar sus habilidades, compartir
            experiencias y participar en actividades culturales.
        </p>

        <img
            src="/img/espacio-cultural.png"
            alt="Actividades artísticas en Espacio Cultural"
        />
    </section>
</Layout>
